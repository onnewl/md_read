{
  "name": "markdown-viewer",
  "version": "0.1.36",
  "description": "A secure local Markdown document viewer built with Electron, React and TypeScript.",
  "main": "out/main/index.js",
  "author": {
    "name": "Markdown Viewer Team",
    "email": "maintainer@example.com"
  },
  "homepage": "https://example.com/markdown-viewer",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dist:all": "pnpm build && electron-builder --mac --win --linux",
    "license:check": "license-checker-rseidelsohn --production --markdown --out THIRD_PARTY_LICENSES.md"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.6"
  },
  "build": {
    "appId": "local.markdown.viewer",
    "productName": "Markdown Viewer",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "artifactBuildCompleted": "./build/update-portable.cjs",
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES.md",
      "!**/node_modules/**"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Markdown Viewer Team <maintainer@example.com>",
      "synopsis": "A secure local Markdown document viewer",
      "description": "A secure local Markdown document viewer built with Electron, React and TypeScript.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}",
      "useZip": true
    }
  }
}
